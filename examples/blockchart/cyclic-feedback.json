{
  "version": 1,
  "diagram": {
    "name": "Control Feedback"
  },
  "modules": [
    {
      "id": "controller",
      "label": "Controller",
      "ports": [
        {
          "id": "status",
          "direction": "input",
          "width": 8
        },
        {
          "id": "command",
          "direction": "output",
          "width": 8
        }
      ]
    },
    {
      "id": "datapath",
      "label": "Data Path",
      "ports": [
        {
          "id": "command",
          "direction": "input",
          "width": 8
        },
        {
          "id": "result",
          "direction": "output",
          "width": 8
        }
      ]
    },
    {
      "id": "monitor",
      "label": "Monitor",
      "ports": [
        {
          "id": "result",
          "direction": "input",
          "width": 8
        },
        {
          "id": "status",
          "direction": "output",
          "width": 8
        }
      ]
    }
  ],
  "connections": [
    {
      "from": "controller.command",
      "to": [
        "datapath.command"
      ],
      "id": "net_1",
      "style": {
        "endArrow": "none"
      }
    },
    {
      "from": "datapath.result",
      "to": [
        "monitor.result"
      ],
      "id": "net_2",
      "style": {
        "endArrow": "none"
      }
    },
    {
      "from": "monitor.status",
      "to": [
        "controller.status"
      ],
      "id": "net_3",
      "style": {
        "endArrow": "none"
      }
    }
  ]
}
