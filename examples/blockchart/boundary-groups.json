{
  "version": 1,
  "diagram": {
    "name": "Nested boundary ports",
    "style": {
      "connection": {
        "strokeColor": "#2563eb",
        "label": {
          "fontSize": 12,
          "backgroundColor": "#ffffff",
          "padding": 2
        }
      }
    }
  },
  "modules": [
    {
      "id": "Source",
      "ports": [
        {
          "id": "out",
          "direction": "output",
          "width": 8
        }
      ]
    },
    {
      "id": "Decode",
      "ports": [
        {
          "id": "in",
          "direction": "input",
          "width": 8
        },
        {
          "id": "out",
          "direction": "output",
          "width": 8
        },
        {
          "id": "retry",
          "direction": "input",
          "width": 1
        }
      ]
    },
    {
      "id": "Sink",
      "ports": [
        {
          "id": "in",
          "direction": "input",
          "width": 8
        }
      ]
    },
    {
      "id": "Ingress",
      "ports": [
        {
          "id": "in",
          "direction": "input",
          "width": 8
        },
        {
          "id": "ready",
          "direction": "input",
          "width": 1
        },
        {
          "id": "out",
          "direction": "output",
          "width": 8
        }
      ],
      "style": {
        "borderColor": "#2563eb",
        "fillColor": "#f8fbff"
      }
    },
    {
      "id": "Bypass",
      "ports": [
        {
          "id": "in",
          "direction": "input",
          "width": 8
        },
        {
          "id": "out",
          "direction": "output",
          "width": 8
        }
      ],
      "style": {
        "borderColor": "#2563eb",
        "fillColor": "#f8fbff"
      }
    },
    {
      "id": "ResultMux",
      "ports": [
        {
          "id": "processed",
          "direction": "input",
          "width": 8
        },
        {
          "id": "bypass",
          "direction": "input",
          "width": 8
        },
        {
          "id": "out",
          "direction": "output",
          "width": 8
        }
      ],
      "style": {
        "borderColor": "#2563eb",
        "fillColor": "#f8fbff"
      }
    },
    {
      "id": "OutputQueue",
      "ports": [
        {
          "id": "in",
          "direction": "input",
          "width": 8
        },
        {
          "id": "out",
          "direction": "output",
          "width": 8
        }
      ],
      "style": {
        "borderColor": "#2563eb",
        "fillColor": "#f8fbff"
      }
    },
    {
      "id": "Monitor",
      "ports": [
        {
          "id": "in",
          "direction": "input",
          "width": 8
        },
        {
          "id": "ready",
          "direction": "output",
          "width": 1
        }
      ],
      "style": {
        "borderColor": "#2563eb",
        "fillColor": "#f8fbff"
      }
    },
    {
      "id": "Execute",
      "ports": [
        {
          "id": "in",
          "direction": "input",
          "width": 8
        },
        {
          "id": "out",
          "direction": "output",
          "width": 8
        }
      ],
      "style": {
        "borderColor": "#0f766e",
        "fillColor": "#ffffff"
      }
    },
    {
      "id": "Check",
      "ports": [
        {
          "id": "in",
          "direction": "input",
          "width": 8
        },
        {
          "id": "flags",
          "direction": "output",
          "width": 8
        }
      ],
      "style": {
        "borderColor": "#0f766e",
        "fillColor": "#ffffff"
      }
    },
    {
      "id": "Join",
      "ports": [
        {
          "id": "data",
          "direction": "input",
          "width": 8
        },
        {
          "id": "flags",
          "direction": "input",
          "width": 8
        },
        {
          "id": "out",
          "direction": "output",
          "width": 8
        }
      ],
      "style": {
        "borderColor": "#0f766e",
        "fillColor": "#ffffff"
      }
    },
    {
      "id": "Trace",
      "ports": [
        {
          "id": "in",
          "direction": "input",
          "width": 8
