  "groups": [
    {
      "id": "Outer",
      "label": "Processing subsystem",
      "members": [
        "Ingress",
        "Inner",
        "Bypass",
        "ResultMux",
        "OutputQueue",
        "Monitor"
      ],
      "ports": [
        {
          "id": "in",
          "label": "Data\nin",
          "direction": "input",
          "width": 8
        },
        {
          "id": "spare",
          "label": "Reserved",
          "direction": "input"
        },
        {
          "id": "out",
          "label": "Result",
          "direction": "output",
          "width": 8
        }
      ],
      "style": {
        "borderColor": "#2563eb",
        "borderStyle": "solid",
        "fillColor": "#eff6ff",
        "portLabel": {
          "fontSize": 12,
          "color": "#1e40af"
        }
      },
      "type": "boundary"
    },
    {
      "id": "Inner",
      "label": "Decode / execute core",
      "members": [
        "Decode",
        "Execute",
        "Check",
        "Join",
        "Trace"
      ],
      "ports": [
        {
          "id": "in",
          "direction": "input",
          "width": 8
        },
        {
          "id": "out",
          "direction": "output",
          "width": 8
        }
      ],
      "style": {
        "borderColor": "#0f766e",
        "fillColor": "#f0fdfa",
        "inputPortLabel": {
          "color": "#0f766e"
        }
      },
      "type": "boundary"
    }
  ],
  "connections": [
    {
      "from": "Source.out",
      "to": [
        "Outer.in"
      ],
      "label": "Request",
      "id": "net_1",
      "style": {
        "endArrow": "none"
      }
    },
    {
      "from": "Outer.in",
      "to": [
        "Ingress.in",
        {
          "endpoint": "Bypass.in",
          "style": {
            "strokeColor": "#64748b"
          }
        }
      ],
      "label": "Bypass",
      "id": "net_2",
      "style": {
        "endArrow": "none"
      }
    },
    {
      "from": "Ingress.out",
      "to": [
        "Inner.in"
      ],
      "label": "Queued",
      "id": "net_3",
      "style": {
        "endArrow": "none"
      }
    },
    {
      "from": "Inner.in",
      "to": [
        "Decode.in"
      ],
      "id": "net_4",
      "style": {
        "endArrow": "none"
      }
    },
    {
      "from": "Decode.out",
      "to": [
        "Execute.in",
        "Check.in"
      ],
      "label": "Dispatch",
      "id": "net_5",
      "style": {
        "endArrow": "none"
      }
    },
    {
      "from": "Execute.out",
      "to": [
        "Join.data"
      ],
      "id": "net_6",
      "style": {
        "endArrow": "none"
      }
    },
    {
      "from": "Check.flags",
      "to": [
        "Join.flags"
      ],
      "label": "Flags",
      "id": "net_7",
      "style": {
        "endArrow": "none"
      }
    },
    {
      "from": "Join.out",
      "to": [
        "Inner.out",
        "Trace.in"
      ],
      "id": "net_8",
      "style": {
        "endArrow": "none"
      }
    },
    {
      "from": "Inner.out",
      "to": [
        "ResultMux.processed"
      ],
      "label": "Processed",
      "id": "net_9",
      "style": {
        "endArrow": "none"
      }
    },
    {
      "from": "Bypass.out",
      "to": [
        "ResultMux.bypass"
      ],
      "style": {
        "strokeColor": "#64748b",
        "endArrow": "none"
      },
      "id": "net_10"
    },
    {
      "from": "ResultMux.out",
      "to": [
        "OutputQueue.in"
      ],
      "id": "net_11",
      "style": {
        "endArrow": "none"
      }
    },
    {
      "from": "OutputQueue.out",
      "to": [
        "Outer.out",
        "Monitor.in"
      ],
      "id": "net_12",
      "style": {
        "endArrow": "none"
      }
    },
    {
      "from": "Outer.out",
      "to": [
        "Sink.in"
      ],
      "label": "Response",
      "id": "net_13",
      "style": {
        "endArrow": "none"
      }
    },
    {
      "from": "Trace.retry",
      "to": [
        "Decode.retry"
      ],
      "label": "Retry",
      "style": {
        "strokeColor": "#b45309",
        "lineStyle": "dashed",
        "endArrow": "none"
      },
      "feedback": true,
      "id": "net_14"
    },
    {
      "from": "Monitor.ready",
      "to": [
        "Ingress.ready"
      ],
      "label": "Ready",
      "style": {
        "strokeColor": "#7c3aed",
        "lineStyle": "dashed",
        "endArrow": "none"
      },
      "feedback": true,
      "id": "net_15"
    }
  ],
  "layout": {
    "direction": "right",
    "feedbackRouting": "elk"
  }
}
