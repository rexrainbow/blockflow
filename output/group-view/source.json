{
  "version": 1,
  "diagram": {
    "name": "Nested boundary ports",
    "style": {
      "connection": {
        "strokeColor": "#2563eb",
        "label": {
          "fontSize": 12,
          "backgroundColor": "#ffffff",
          "padding": 2
        }
      }
    }
  },
  "modules": [
    {
      "id": "Source",
      "ports": [
        {
          "id": "out",
          "direction": "output",
          "width": 8
        }
      ]
    },
    {
      "id": "Decode",
      "ports": [
        {
          "id": "in",
          "direction": "input",
          "width": 8
        },
        {
          "id": "out",
          "direction": "output",
          "width": 8
        },
        {
          "id": "retry",
          "direction": "input",
          "width": 1
        }
      ]
    },
    {
      "id": "Sink",
      "ports": [
        {
          "id": "in",
          "direction": "input",
          "width": 8
        }
      ]
    },
    {
      "id": "Ingress",
      "ports": [
        {
          "id": "in",
          "direction": "input",
          "width": 8
        },
        {
          "id": "ready",
          "direction": "input",
          "width": 1
        },
        {
          "id": "out",
          "direction": "output",
          "width": 8
        }
      ],
      "style": {
        "borderColor": "#2563eb",
        "fillColor": "#f8fbff"
      }
    },
    {
      "id": "Bypass",
      "ports": [
        {
          "id": "in",
          "direction": "input",
          "width": 8
        },
        {
          "id": "out",
          "direction": "output",
          "width": 8
        }
      ],
      "style": {
        "borderColor": "#2563eb",
        "fillColor": "#f8fbff"
      }
    },
    {
      "id": "ResultMux",
      "ports": [
        {
          "id": "processed",
          "direction": "input",
          "width": 8
        },
        {
          "id": "bypass",
          "direction": "input",
          "width": 8
        },
        {
          "id": "out",
          "direction": "output",
          "width": 8
        }
      ],
      "style": {
        "borderColor": "#2563eb",
        "fillColor": "#f8fbff"
      }
    },
    {
      "id": "OutputQueue",
      "ports": [
        {
          "id": "in",
          "direction": "input",
          "width": 8
        },
        {
          "id": "out",
          "direction": "output",
          "width": 8
        }
      ],
      "style": {
        "borderColor": "#2563eb",
        "fillColor": "#f8fbff"
      }
    },
    {
      "id": "Monitor",
      "ports": [
        {
          "id": "in",
          "direction": "input",
          "width": 8
        },
        {
          "id": "ready",
          "direction": "output",
          "width": 1
        }
      ],
      "style": {
        "borderColor": "#2563eb",
        "fillColor": "#f8fbff"
      }
    },
    {
      "id": "Execute",
      "ports": [
        {
          "id": "in",
          "direction": "input",
          "width": 8
        },
        {
          "id": "out",
          "direction": "output",
          "width": 8
        }
      ],
      "style": {
        "borderColor": "#0f766e",
        "fillColor": "#ffffff"
      }
    },
    {
      "id": "Check",
      "ports": [
        {
          "id": "in",
          "direction": "input",
          "width": 8
        },
        {
          "id": "flags",
          "direction": "output",
          "width": 8
        }
      ],
      "style": {
        "borderColor": "#0f766e",
        "fillColor": "#ffffff"
      }
    },
    {
      "id": "Join",
      "ports": [
        {
          "id": "data",
          "direction": "input",
          "width": 8
        },
        {
          "id": "flags",
          "direction": "input",
          "width": 8
        },
        {
          "id": "out",
          "direction": "output",
          "width": 8
        }
      ],
      "style": {
        "borderColor": "#0f766e",
        "fillColor": "#ffffff"
      }
    },
    {
      "id": "Trace",
      "ports": [
        {
          "id": "in",
          "direction": "input",
          "width": 8
        },
        {
          "id": "retry",
          "direction": "output",
          "width": 1
        }
      ],
      "style": {
        "borderColor": "#0f766e",
        "fillColor": "#ffffff"
      }
    }
  ],
  "groups": [
    {
      "id": "Outer",
      "label": "Processing subsystem",
      "members": [
        "Ingress",
        "Inner",
        "Bypass",
        "ResultMux",
        "OutputQueue",
        "Monitor"
      ],
      "portMode": "boundary",
      "ports": [
        {
          "id": "in",
          "label": "Data\nin",
          "direction": "input",
          "width": 8
        },
        {
          "id": "spare",
          "label": "Reserved",
          "direction": "input"
        },
        {
          "id": "out",
          "label": "Result",
          "direction": "output",
          "width": 8
        }
      ],
      "style": {
        "borderColor": "#2563eb",
        "borderStyle": "solid",
        "fillColor": "#eff6ff",
        "portLabel": {
          "fontSize": 12,
          "color": "#1e40af"
        }
      },
      "collapsed": true
    },
    {
      "id": "Inner",
      "label": "Decode / execute core",
      "members": [
        "Decode",
        "Execute",
        "Check",
        "Join",
        "Trace"
      ],
      "portMode": "boundary",
      "ports": [
        {
          "id": "in",
          "direction": "input",
          "width": 8
        },
        {
          "id": "out",
          "direction": "output",
          "width": 8
        }
      ],
      "style": {
        "borderColor": "#0f766e",
        "fillColor": "#f0fdfa",
        "inputPortLabel": {
          "color": "#0f766e"
        }
      },
      "collapsed": true
    }
  ],
  "connections": [
    {
      "from": "Source.out",
      "to": "Outer.in",
      "label": "Request"
    },
    {
      "from": "Outer.in",
      "to": "Ingress.in"
    },
    {
      "from": "Ingress.out",
      "to": "Inner.in",
      "label": "Queued"
    },
    {
      "from": "Inner.in",
      "to": "Decode.in"
    },
    {
      "from": "Decode.out",
      "to": "Execute.in",
      "label": "Dispatch"
    },
    {
      "from": "Decode.out",
      "to": "Check.in"
    },
    {
      "from": "Execute.out",
      "to": "Join.data"
    },
    {
      "from": "Check.flags",
      "to": "Join.flags",
      "label": "Flags"
    },
    {
      "from": "Join.out",
      "to": "Inner.out"
    },
    {
      "from": "Inner.out",
      "to": "ResultMux.processed",
      "label": "Processed"
    },
    {
      "from": "Outer.in",
      "to": "Bypass.in",
      "label": "Bypass",
      "style": {
        "strokeColor": "#64748b"
      }
    },
    {
      "from": "Bypass.out",
      "to": "ResultMux.bypass",
      "style": {
        "strokeColor": "#64748b"
      }
    },
    {
      "from": "ResultMux.out",
      "to": "OutputQueue.in"
    },
    {
      "from": "OutputQueue.out",
      "to": "Outer.out"
    },
    {
      "from": "Outer.out",
      "to": "Sink.in",
      "label": "Response"
    },
    {
      "from": "Join.out",
      "to": "Trace.in"
    },
    {
      "from": "Trace.retry",
      "to": "Decode.retry",
      "label": "Retry",
      "style": {
        "strokeColor": "#b45309",
        "lineStyle": "dashed"
      },
      "feedback": true
    },
    {
      "from": "OutputQueue.out",
      "to": "Monitor.in"
    },
    {
      "from": "Monitor.ready",
      "to": "Ingress.ready",
      "label": "Ready",
      "style": {
        "strokeColor": "#7c3aed",
        "lineStyle": "dashed"
      },
      "feedback": true
    }
  ],
  "layout": {
    "direction": "right",
    "feedbackRouting": "elk"
  }
}
