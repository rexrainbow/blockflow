{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:blockchart:diagram:1",
  "title": "Blockchart diagram input, version 1",
  "description": "Raw input JSON, not a normalized model or layout result. Validate cross-object semantics with createDiagramModel; render to check layout. Defaults are annotations, not inserted values.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "diagram", "modules"],
  "properties": {
    "version": {
      "const": 1
    },
    "diagram": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "$ref": "#/$defs/text"
        },
        "style": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "module": {
              "$ref": "#/$defs/moduleStyle"
            },
            "connection": {
              "$ref": "#/$defs/connectionStyle"
            },
            "caption": {
              "$ref": "#/$defs/textStyle"
            },
            "text": {
              "$ref": "#/$defs/textStyle",
              "description": "Shared diagram text base. Per-type defaults and local properties override it."
            },
            "group": {
              "$ref": "#/$defs/groupStyle"
            },
            "terminal": {
              "$ref": "#/$defs/textStyle"
            }
          }
        },
        "caption": {
          "$ref": "#/$defs/displayText"
        }
      }
    },
    "modules": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/module"
      },
      "description": "Module IDs must be unique. Module array order does not impose layout positions."
    },
    "connections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/connection"
      },
      "default": []
    },
    "layout": {
      "$ref": "#/$defs/layout"
    },
    "groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/group"
      },
      "description": "Optional hierarchical groups. Members reference block or group IDs. Each item has at most one parent; cycles are rejected. Unlisted items remain at root."
    },
    "terminals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/terminal"
      },
      "description": "Root external inputs and outputs. Same-side anchors align by default outside the internal layout, with their text and signal label footprints. Reduce bends preserves the side alignment. IDs share the block/group namespace. Each connected terminal must connect to a real block or boundary-group port."
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$(?![\\s\\S])"
    },
    "endpoint": {
      "anyOf": [
        {
          "$ref": "#/$defs/portEndpoint"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["terminal"],
          "properties": {
            "terminal": {
              "$ref": "#/$defs/id"
            }
          }
        }
      ]
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {
          "pattern": "\\S"
        },
        {
          "pattern": "^[^\\u0000-\\u001f\\ud800-\\udfff\\ufffe\\uffff\\u2028\\u2029]*$(?![\\s\\S])"
        }
      ],
      "description": "Non-blank, single-line XML-compatible text; Unicode labels are allowed."
    },
    "positive": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1.7976931348623157e308
    },
    "nonNegative": {
      "type": "number",
      "minimum": 0,
      "maximum": 1.7976931348623157e308
    },
    "opacity": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "color": {
      "type": "string",
      "pattern": "^(?:transparent|#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8}))$(?![\\s\\S])",
      "description": "Hex RGB/RGBA or transparent; CSS names, rgb(), variables and URLs are unsupported."
    },
    "lineStyle": {
      "enum": ["solid", "dashed", "dotted"]
    },
    "textStyle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "color": {
          "$ref": "#/$defs/color"
        },
        "backgroundColor": {
          "$ref": "#/$defs/color"
        },
        "fontSize": {
          "$ref": "#/$defs/positive"
        },
        "padding": {
          "$ref": "#/$defs/nonNegative"
        },
        "opacity": {
          "$ref": "#/$defs/opacity"
        },
        "backgroundOpacity": {
          "$ref": "#/$defs/opacity"
        },
        "hidden": {
          "type": "boolean",
          "default": false,
          "description": "Hide text, background and width notation without reserving text space. The owning object and endpoints remain."
        },
        "textAlign": {
          "enum": ["left", "center", "right"],
          "description": "Align lines within the existing measured text block; omission preserves current alignment."
        }
      }
    },
    "moduleStyle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "borderColor": {
          "$ref": "#/$defs/color"
        },
        "borderWidth": {
          "$ref": "#/$defs/positive"
        },
        "borderStyle": {
          "$ref": "#/$defs/lineStyle"
        },
        "borderOpacity": {
          "$ref": "#/$defs/opacity"
        },
        "fillColor": {
          "$ref": "#/$defs/color"
        },
        "fillOpacity": {
          "$ref": "#/$defs/opacity"
        },
        "label": {
          "$ref": "#/$defs/textStyle"
        },
        "portLabel": {
          "$ref": "#/$defs/textStyle"
        },
        "inputPortLabel": {
          "$ref": "#/$defs/textStyle"
        },
        "outputPortLabel": {
          "$ref": "#/$defs/textStyle"
        }
      }
    },
    "connectionStyle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strokeColor": {
          "$ref": "#/$defs/color"
        },
        "strokeWidth": {
          "$ref": "#/$defs/positive"
        },
        "lineStyle": {
          "$ref": "#/$defs/lineStyle"
        },
        "opacity": {
          "$ref": "#/$defs/opacity"
        },
        "label": {
          "$ref": "#/$defs/connectionLabelStyle"
        },
        "endArrow": {
          "enum": ["none", "triangle"],
          "default": "none",
          "description": "Arrow at the connection target, using line color and opacity."
        },
        "startArrow": {
          "enum": ["none", "triangle"],
          "default": "none"
        }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/displayText",
          "description": "Optional display name. Omit to display the ID and follow future ID changes."
        },
        "ports": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/port"
          },
          "description": "Port IDs must be unique within this module, across both directions. Array order preserves per-side top-to-bottom port order."
        },
        "style": {
          "$ref": "#/$defs/moduleStyle"
        },
        "width": {
          "$ref": "#/$defs/positive",
          "description": "Optional relative minimum width, measured against a shared fixed block-size unit (1). Omit for Auto. Does not scale text, strokes or padding. Port width remains bit width."
        },
        "height": {
          "$ref": "#/$defs/positive",
          "description": "Optional relative minimum height, measured against a shared fixed block-size unit (1). Omit for Auto. Does not scale text, strokes or padding. Port width remains bit width."
        },
        "appearance": {
          "$ref": "#/$defs/appearance",
          "description": "Ordinary Block appearance. Concat has a fixed Bar appearance; omit this field or use {\"type\":\"bar\"}."
        },
        "type": {
          "enum": ["block", "concat"],
          "default": "block",
          "description": "Concat combines inputs in array order, first input at the high end. Requires one or more inputs and exactly one output. Width sum is checked only when every port has an explicit width; widths are never inferred. Concat always draws a thin Flow-aligned Bar; port sides must follow Flow (right: input left/output right; down: input top/output bottom)."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "concat"
              }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "ports": {
                "allOf": [
                  {
                    "contains": {
                      "properties": {
                        "direction": {
                          "const": "input"
                        }
                      },
                      "type": "object"
                    },
                    "minContains": 1,
                    "type": "array"
                  },
                  {
                    "contains": {
                      "properties": {
                        "direction": {
                          "const": "output"
                        }
                      },
                      "type": "object"
                    },
                    "minContains": 1,
                    "maxContains": 1,
                    "type": "array"
                  }
                ],
                "items": {
                  "type": "object",
                  "properties": {
                    "direction": {
                      "enum": ["input", "output"]
                    }
                  }
                },
                "type": "array"
              },
              "appearance": {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "bar"
                  }
                }
              }
            },
            "required": ["ports"]
          }
        }
      ]
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "direction"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "direction": {
          "enum": ["input", "output", "inout"]
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "Omit for unknown width. Explicit null is invalid. Compare widths only when both endpoints specify them."
        },
        "style": {
          "$ref": "#/$defs/textStyle"
        },
        "label": {
          "$ref": "#/$defs/displayText",
          "description": "Optional display name; omit to follow the port ID. Width notation is appended to the last line."
        },
        "side": {
          "enum": ["left", "right", "top", "bottom"]
        }
      }
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": {
          "$ref": "#/$defs/endpoint"
        },
        "to": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/endpoint"
              },
              {
                "$ref": "#/$defs/netTarget"
              }
            ]
          }
        },
        "style": {
          "$ref": "#/$defs/connectionStyle"
        },
        "feedback": {
          "type": "boolean",
          "default": false,
          "description": "Prefer this connection as feedback during cycle breaking. False or omitted maps to ELK direction priority 10; true maps to 0. Still participates in layout; does not force backward routing, exclude rank constraints or activate staged mode."
        },
        "label": {
          "$ref": "#/$defs/displayText",
          "description": "Optional multiline display text. Omit for no label. Layout measures all lines and checks final routes for collisions."
        },
        "direction": {
          "enum": ["forward", "both"],
          "default": "forward",
          "description": "Forward Net or bidirectional abstract interface. Both requires inout ports at every endpoint; one selected master/reference may fan out to multiple peers. No arbitration or timing simulation."
        },
        "constraint": {
          "type": "boolean",
          "default": true
        },
        "id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "direction": {
          "enum": ["right", "down"],
          "default": "right",
          "description": "Main flow direction."
        },
        "routing": {
          "const": "orthogonal",
          "default": "orthogonal"
        },
        "placement": {
          "enum": ["default", "relaxed", "simple"],
          "default": "default",
          "description": "Prefer default or relaxed. simple is retained by the library for compatibility."
        },
        "feedbackRouting": {
          "enum": ["elk", "outer"],
          "default": "elk",
          "description": "outer requires right or down direction and attempts exterior AABB routes, falling back to ELK when access is blocked."
        },
        "feedbackMargin": {
          "$ref": "#/$defs/positive",
          "default": 20
        },
        "feedbackLaneSpacing": {
          "$ref": "#/$defs/positive",
          "default": 12
        },
        "moduleSpacing": {
          "$ref": "#/$defs/positive",
          "default": 50,
          "description": "Explicit node/component spacing; defaults to 20."
        },
        "layerSpacing": {
          "$ref": "#/$defs/positive",
          "default": 80,
          "description": "Explicit layer spacing; defaults to 30. Eligible Auto Container regions count existing inner gutters toward content separation."
        },
        "portAdjustment": {
          "enum": ["fixed", "reduce-bends"],
          "default": "reduce-bends",
          "description": "Post-placement sliding of rectangular/stacked block ports and terminal anchors with their labels. Reduce bends accepts only improvements without increasing obstacle-hit or foreign-net crossing/overlap counts; terminal order/spacing are preserved; feedback anchors, Concat and group ports stay fixed."
        },
        "maxPortShift": {
          "$ref": "#/$defs/nonNegative",
          "default": 40,
          "description": "Maximum displacement in logical SVG units, along the original block side or perpendicular to flow for terminal anchors and labels. Endpoint order, label clearance and minimum spacing may reduce the range. Zero disables adjustment."
        },
        "feedbackSide": {
          "enum": ["auto", "top", "bottom", "left", "right"],
          "default": "auto",
          "description": "Exterior side: auto/top/bottom for horizontal flow, auto/left/right for down. Only used by outer routing; blocked access keeps the ELK route."
        },
        "type": {
          "enum": ["auto", "grid"],
          "default": "auto",
          "description": "Auto by default. Grid fixes only listed cells and places remaining direct members automatically outside the reserved Grid rectangle."
        },
        "cells": {
          "$ref": "#/$defs/gridCells"
        },
        "rowGap": {
          "type": "number",
          "description": "Minimum row gap; Down Grid routing expands only crowded gaps to reserve separate Net tracks.",
          "minimum": 0,
          "default": 50
        },
        "columnGap": {
          "type": "number",
          "description": "Minimum column gap; Right Grid routing expands only crowded gaps to reserve separate Net tracks.",
          "minimum": 0,
          "default": 80
        },
        "blockMinWidth": {
          "$ref": "#/$defs/positive",
          "description": "Grid-only minimum ordinary Block dimension in 140-unit increments, applied only to explicit module cells. Omit for Auto. Concat and Container cells are excluded; content and per-Block minima may require larger geometry."
        },
        "blockMinHeight": {
          "$ref": "#/$defs/positive",
          "description": "Grid-only minimum ordinary Block dimension in 84-unit increments, applied only to explicit module cells. Omit for Auto. Concat and Container cells are excluded; content and per-Block minima may require larger geometry."
        },
        "blockAlign": {
          "enum": ["left", "center", "right"],
          "default": "center",
          "description": "Grid-only physical horizontal alignment of explicit cell Blocks or whole Containers. Omit for center; vertical alignment stays centered. Does not change text alignment or stretch Blocks."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "direction": {
                "const": "down"
              }
            },
            "required": ["direction"]
          },
          "then": {
            "type": "object",
            "properties": {
              "feedbackSide": {
                "enum": ["auto", "left", "right"]
              }
            }
          },
          "else": {
            "type": "object",
            "properties": {
              "feedbackSide": {
                "enum": ["auto", "top", "bottom"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "grid"
              }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["cells"],
            "properties": {
              "cells": {
                "$ref": "#/$defs/gridCells"
              }
            }
          },
          "else": {
            "not": {
              "required": ["cells"],
              "properties": {
                "cells": {}
              }
            },
            "properties": {
              "blockMinWidth": false,
              "blockMinHeight": false,
              "blockAlign": false
            }
          }
        }
      ]
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "members"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/displayText",
          "description": "Optional display name. Omit to display the ID and follow future ID changes."
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "style": {
          "$ref": "#/$defs/groupStyle"
        },
        "ports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/port"
          },
          "description": "Group interface definitions; active only in boundary mode. Empty and unused ports are valid."
        },
        "collapsed": {
          "type": "boolean",
          "default": false,
          "description": "Hide contents for Boundary or Collection. Container groups must remain expanded. JSON contents are retained."
        },
        "width": {
          "$ref": "#/$defs/positive",
          "description": "Optional relative minimum width in the shared block-size unit. Collapsed groups use regular-block geometry; expanded groups also grow to fit children. Omit for Auto."
        },
        "height": {
          "$ref": "#/$defs/positive",
          "description": "Optional relative minimum height in the shared block-size unit. Collapsed groups use regular-block geometry; expanded groups also grow to fit children. Omit for Auto."
        },
        "type": {
          "enum": ["container", "boundary", "collection"],
          "default": "container",
          "description": "Container groups organize contents; Boundary groups expose real ports; Collection groups use virtual overview anchors when collapsed."
        },
        "layout": {
          "$ref": "#/$defs/gridLayout"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "collapsed": {
                "const": true
              }
            },
            "required": ["collapsed"]
          },
          "then": {
            "properties": {
              "type": {
                "enum": ["boundary", "collection"]
              }
            },
            "required": ["type"]
          }
        }
      ]
    },
    "groupStyle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "borderColor": {
          "$ref": "#/$defs/color"
        },
        "borderWidth": {
          "$ref": "#/$defs/positive"
        },
        "borderStyle": {
          "$ref": "#/$defs/lineStyle"
        },
        "borderOpacity": {
          "$ref": "#/$defs/opacity"
        },
        "fillColor": {
          "$ref": "#/$defs/color"
        },
        "fillOpacity": {
          "$ref": "#/$defs/opacity"
        },
        "label": {
          "$ref": "#/$defs/textStyle"
        },
        "portLabel": {
          "$ref": "#/$defs/textStyle"
        },
        "inputPortLabel": {
          "$ref": "#/$defs/textStyle"
        },
        "outputPortLabel": {
          "$ref": "#/$defs/textStyle"
        },
        "borderRadius": {
          "type": "number",
          "minimum": 0,
          "default": 0,
          "description": "Group rectangle corner radius in logical SVG units; clamped to half the inset width/height. Applies to expanded frames and collapsed faces/backing cards, without changing layout or Port positions."
        }
      }
    },
    "displayText": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {
          "pattern": "\\S"
        },
        {
          "pattern": "^[^\\u0000-\\u0009\\u000b\\u000c\\u000e-\\u001f\\ud800-\\udfff\\ufffe\\uffff\\u2028\\u2029]*$(?![\\s\\S])"
        },
        {
          "pattern": "^(?:[^\\r]|\\r\\n)*$(?![\\s\\S])"
        }
      ],
      "description": "Non-blank XML-compatible display text. LF line breaks are supported; CRLF is normalized to LF."
    },
    "portEndpoint": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*\\.[A-Za-z_][A-Za-z0-9_]*$(?![\\s\\S])",
      "description": "Existing ownerId.portId, where owner is a block or boundary group. Block sources are outputs and targets are inputs. Group inputs send inward and receive from outside; group outputs receive inward and send outside. Cross each enabled boundary through its ports."
    },
    "terminal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "direction"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "direction": {
          "enum": ["input", "output"],
          "description": "Direction relative to the diagram: input sends inward; output receives from inside. Inputs appear left and outputs right."
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "Omit for unknown width. Explicit null is invalid. Compare widths only when both endpoints specify them."
        },
        "style": {
          "$ref": "#/$defs/textStyle"
        },
        "label": {
          "$ref": "#/$defs/displayText",
          "description": "Optional display name; omit to follow the port ID. Width notation is appended to the last line."
        }
      }
    },
    "appearance": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": {
              "const": "rectangle"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": {
              "const": "stacked"
            },
            "layers": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3,
              "default": 2
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": {
              "const": "trapezoid"
            },
            "rightHeightRatio": {
              "type": "number",
              "minimum": 0.2,
              "maximum": 1,
              "default": 0.6
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": {
              "const": "bar"
            }
          }
        }
      ]
    },
    "gridCells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "Rectangular matrix of eligible IDs or null. Direct members may be omitted for Auto. Placing a direct nonempty Container ID keeps it atomic; placing any of its direct children expands it and requires all direct children exactly once. Parent and child IDs cannot coexist. Expanded regions must be disjoint rectangles containing only that Container's children or null. Expansion is one level per scope; Boundary and Collection remain atomic. Null cells reserve space. Rows and columns are derived from this matrix."
    },
    "gridLayout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "moduleSpacing": {
          "$ref": "#/$defs/positive",
          "description": "Optional local Auto node/component spacing. Omit to inherit the nearest ancestor override, then root/default. Grid gaps remain independent."
        },
        "layerSpacing": {
          "$ref": "#/$defs/positive",
          "description": "Optional local Auto layer-spacing budget. Omit to inherit the nearest ancestor override, then root/default. Does not control the group's external gap or Grid tracks."
        },
        "type": {
          "enum": ["auto", "grid"],
          "default": "auto"
        },
        "cells": {
          "$ref": "#/$defs/gridCells"
        },
        "rowGap": {
          "type": "number",
          "description": "Minimum row gap; Down Grid routing expands only crowded gaps to reserve separate Net tracks.",
          "minimum": 0,
          "default": 50
        },
        "columnGap": {
          "type": "number",
          "description": "Minimum column gap; Right Grid routing expands only crowded gaps to reserve separate Net tracks.",
          "minimum": 0,
          "default": 80
        },
        "blockMinWidth": {
          "$ref": "#/$defs/positive",
          "description": "Grid-only minimum ordinary Block dimension in 140-unit increments, applied only to explicit module cells. Omit for Auto. Concat and Container cells are excluded; content and per-Block minima may require larger geometry."
        },
        "blockMinHeight": {
          "$ref": "#/$defs/positive",
          "description": "Grid-only minimum ordinary Block dimension in 84-unit increments, applied only to explicit module cells. Omit for Auto. Concat and Container cells are excluded; content and per-Block minima may require larger geometry."
        },
        "blockAlign": {
          "enum": ["left", "center", "right"],
          "default": "center",
          "description": "Grid-only physical horizontal alignment of explicit cell Blocks or whole Containers. Omit for center; vertical alignment stays centered. Does not change text alignment or stretch Blocks."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "grid"
              }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["cells"],
            "properties": {
              "cells": {
                "$ref": "#/$defs/gridCells"
              }
            }
          },
          "else": {
            "not": {
              "required": ["cells"],
              "properties": {
                "cells": {}
              }
            },
            "properties": {
              "blockMinWidth": false,
              "blockMinHeight": false,
              "blockAlign": false
            }
          }
        }
      ],
      "description": "One partial Grid per scope. Selected members occupy a reserved rectangle placed among automatic neighbors; hierarchy and signal connections are unchanged."
    },
    "connectionLabelStyle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "color": {
          "$ref": "#/$defs/color"
        },
        "backgroundColor": {
          "$ref": "#/$defs/color"
        },
        "fontSize": {
          "$ref": "#/$defs/positive"
        },
        "padding": {
          "$ref": "#/$defs/nonNegative"
        },
        "opacity": {
          "$ref": "#/$defs/opacity"
        },
        "backgroundOpacity": {
          "$ref": "#/$defs/opacity"
        },
        "hidden": {
          "type": "boolean",
          "default": false,
          "description": "Hide text, background and width notation without reserving text space. The owning object and endpoints remain."
        },
        "repeatAtEnd": {
          "enum": ["auto", "always", "never"],
          "default": "auto",
          "description": "Net destination Inline nodes. Always reserves receiver space in the first layout; Auto selects first-pass branches longer than longThreshold and runs one additional layout with that selection frozen; Never omits receiver labels."
        },
        "longThreshold": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 600,
          "description": "First-pass routed source-to-target length in logical SVG units above which Auto reserves a receiver Inline node in the second layout."
        },
        "borderColor": {
          "$ref": "#/$defs/color",
          "default": "transparent"
        },
        "borderWidth": {
          "$ref": "#/$defs/nonNegative",
          "default": 1,
          "description": "Optional label frame width. Zero hides the frame; rendering keeps the stroke inside reserved label bounds."
        },
        "borderOpacity": {
          "$ref": "#/$defs/opacity",
          "default": 1
        },
        "borderRadius": {
          "$ref": "#/$defs/nonNegative",
          "default": 0,
          "description": "Label background/frame corner radius in logical SVG units, clamped to its dimensions."
        },
        "textAlign": {
          "enum": ["left", "center", "right"],
          "description": "Align lines within the existing measured text block; omission preserves current alignment."
        }
      }
    },
    "netTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint"],
      "properties": {
        "endpoint": {
          "$ref": "#/$defs/endpoint"
        },
        "constraint": {
          "type": "boolean"
        },
        "feedback": {
          "type": "boolean"
        },
        "style": {
          "$ref": "#/$defs/netBranchStyle"
        }
      }
    },
    "netBranchStyle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strokeColor": {
          "$ref": "#/$defs/color"
        },
        "strokeWidth": {
          "$ref": "#/$defs/positive"
        },
        "lineStyle": {
          "$ref": "#/$defs/lineStyle"
        },
        "opacity": {
          "$ref": "#/$defs/opacity"
        },
        "endArrow": {
          "enum": ["none", "triangle"],
          "default": "none",
          "description": "Arrow at the branch target, using line color and opacity. Source arrows belong to the common Net style."
        }
      }
    },
    "concatSidesRight": {
      "type": "object",
      "if": {
        "properties": {
          "type": {
            "const": "concat"
          }
        },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "ports": {
            "type": "array",
            "items": {
              "type": "object",
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "direction": {
                        "const": "input"
                      }
                    },
                    "required": ["direction"]
                  },
                  "then": {
                    "properties": {
                      "side": {
                        "const": "left"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "direction": {
                        "const": "output"
                      }
                    },
                    "required": ["direction"]
                  },
                  "then": {
                    "properties": {
                      "side": {
                        "const": "right"
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "concatSidesDown": {
      "type": "object",
      "if": {
        "properties": {
          "type": {
            "const": "concat"
          }
        },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "ports": {
            "type": "array",
            "items": {
              "type": "object",
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "direction": {
                        "const": "input"
                      }
                    },
                    "required": ["direction"]
                  },
                  "then": {
                    "properties": {
                      "side": {
                        "const": "top"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "direction": {
                        "const": "output"
                      }
                    },
                    "required": ["direction"]
                  },
                  "then": {
                    "properties": {
                      "side": {
                        "const": "bottom"
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  },
  "anyOf": [
    {
      "properties": {
        "modules": {
          "minItems": 1,
          "type": "array"
        }
      }
    },
    {
      "required": ["groups"],
      "properties": {
        "groups": {
          "minItems": 1,
          "type": "array"
        }
      }
    }
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "layout": {
            "type": "object",
            "properties": {
              "direction": {
                "const": "down"
              }
            },
            "required": ["direction"]
          }
        },
        "required": ["layout"]
      },
      "then": {
        "properties": {
          "modules": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/concatSidesDown"
            }
          }
        }
      },
      "else": {
        "properties": {
          "modules": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/concatSidesRight"
            }
          }
        }
      }
    }
  ]
}
