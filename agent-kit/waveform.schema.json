{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:blockflow:waveform:1",
  "title": "Synchronous Blockflow Waveform v1",
  "type": "object",
  "properties": {
    "format": {
      "const": "blockflow-waveform"
    },
    "version": {
      "const": 1
    },
    "title": {
      "type": "string"
    },
    "timescale": {
      "type": "string",
      "minLength": 1
    },
    "length": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "grid": {
      "type": "object",
      "properties": {
        "ticksPerBit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["ticksPerBit"],
      "additionalProperties": false
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z_][\\w.-]*$"
          },
          "label": {
            "type": "string"
          },
          "width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          },
          "scope": {
            "type": "string"
          },
          "port": {
            "type": "string",
            "pattern": "^[A-Za-z_]\\w*\\.[A-Za-z_]\\w*$"
          },
          "changes": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 3,
              "prefixItems": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    }
                  ]
                },
                {
                  "type": "string",
                  "pattern": "^[A-Za-z_][\\w.-]*$"
                }
              ],
              "items": false
            },
            "minItems": 1
          },
          "style": {
            "type": "object",
            "properties": {
              "color": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              }
            },
            "required": ["color"],
            "additionalProperties": false
          }
        },
        "required": ["id", "width", "changes"],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "width": {
                  "const": 1
                }
              }
            },
            "then": {
              "properties": {
                "changes": {
                  "items": {
                    "prefixItems": [
                      {},
                      {
                        "enum": [0, 1, "x", "z"]
                      }
                    ]
                  }
                }
              }
            }
          }
        ]
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^[A-Za-z_][\\w.-]*$"
          },
          "to": {
            "type": "string",
            "pattern": "^[A-Za-z_][\\w.-]*$"
          },
          "label": {
            "type": "string"
          },
          "delay": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "locked": {
            "type": "boolean"
          }
        },
        "required": ["from", "to"],
        "additionalProperties": false
      }
    },
    "markers": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z_][\\w.-]*$"
              },
              "t": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "label": {
                "type": "string"
              }
            },
            "required": ["id", "t"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z_][\\w.-]*$"
              },
              "from": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "to": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "label": {
                "type": "string"
              }
            },
            "required": ["id", "from", "to"],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": ["format", "version", "timescale", "length", "signals"],
  "additionalProperties": false
}
