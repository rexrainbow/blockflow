{
  "format": "blockflow-story",
  "version": 1,
  "title": "Signal path",
  "diagram": {
    "name": "Story editor test: signal path"
  },
  "chapters": [
    {
      "title": "Transmit",
      "steps": [
        {
          "title": "Clock to timer",
          "body": "The external clock drives the bit timer.",
          "hops": [
            {
              "kind": "event",
              "wires": ["@terminal:Clock -> Timer.clk"]
            }
          ],
          "waveform": {
            "from": 0,
            "to": 8,
            "signals": ["tick"]
          }
        },
        {
          "title": "Start both stages",
          "body": "One start net fans out to the FIFO and the Serializer.",
          "hops": [
            {
              "kind": "event",
              "badge": "tick",
              "wires": ["Timer.tick -> Controller.tick"]
            },
            {
              "kind": "control",
              "badge": "start",
              "wires": ["Controller.start -> FIFO.start", "Controller.start -> Serializer.start"]
            }
          ],
          "notes": [
            {
              "module": "Controller",
              "text": "Starts a bit"
            }
          ],
          "waveform": {
            "from": 0,
            "to": 8,
            "signals": ["start"],
            "links": ["timer_tick -> start_edge"]
          }
        },
        {
          "title": "Data out",
          "body": "Data moves through the FIFO to the pad.",
          "hops": [
            {
              "kind": "data",
              "wires": ["Source.data -> FIFO.data"]
            },
            {
              "kind": "data",
              "wires": ["FIFO.q -> Serializer.q"]
            },
            {
              "kind": "level",
              "wires": ["Serializer.line -> @terminal:Pad"]
            }
          ],
          "waveform": {
            "from": 0,
            "to": 16,
            "markers": ["packet"]
          }
        },
        {
          "title": "Overview",
          "body": "Every wire of this chapter at once.",
          "scope": true,
          "camera": "all",
          "hops": [],
          "waveform": {}
        }
      ],
      "waveform": {
        "format": "blockflow-waveform",
        "version": 1,
        "title": "Transmit timing",
        "timescale": "clk",
        "length": 16,
        "grid": {
          "ticksPerBit": 8
        },
        "signals": [
          {
            "id": "tick",
            "width": 1,
            "port": "Timer.tick",
            "changes": [
              [0, 0],
              [1, 1, "timer_tick"],
              [2, 0],
              [9, 1],
              [10, 0]
            ]
          },
          {
            "id": "start",
            "width": 1,
            "port": "Controller.start",
            "changes": [
              [0, 0],
              [2, 1, "start_edge"],
              [4, 0],
              [10, 1],
              [12, 0]
            ]
          }
        ],
        "links": [
          {
            "from": "timer_tick",
            "to": "start_edge",
            "label": "start follows tick",
            "delay": 1,
            "locked": true
          }
        ],
        "markers": [
          {
            "id": "packet",
            "from": 0,
            "to": 16,
            "label": "Packet"
          }
        ]
      }
    },
    {
      "title": "Pad",
      "steps": [
        {
          "title": "Line to pad",
          "body": "",
          "hops": [
            {
              "kind": "level",
              "badge": "line",
              "wires": ["Serializer.line -> @terminal:Pad"]
            }
          ],
          "notes": [
            {
              "module": "@terminal:Pad",
              "text": "Output pin"
            }
          ]
        }
      ]
    }
  ]
}
