{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:blockflow:story:1",
  "title": "Normalized Blockflow Story v1",
  "type": "object",
  "properties": {
    "format": {
      "const": "blockflow-story"
    },
    "version": {
      "const": 1
    },
    "title": {
      "type": "string"
    },
    "diagram": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": ["name"]
    },
    "chapters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/chapter"
      }
    }
  },
  "additionalProperties": false,
  "required": ["format", "version", "title", "chapters"],
  "$defs": {
    "hop": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": ["event", "level", "data", "control"]
        },
        "badge": {
          "type": "string"
        },
        "wires": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": ["kind", "wires"]
    },
    "note": {
      "type": "object",
      "properties": {
        "module": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": ["module", "text"]
    },
    "step": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "scope": {
          "const": true
        },
        "camera": {
          "const": "all"
        },
        "hops": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hop"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/note"
          }
        },
        "waveform": {
          "$ref": "#/$defs/waveformFocus"
        }
      },
      "additionalProperties": false,
      "required": ["title", "body", "hops"]
    },
    "chapter": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "waveform": {
          "$ref": "urn:blockflow:waveform:1"
        }
      },
      "additionalProperties": false,
      "required": ["title", "steps"]
    },
    "waveformFocus": {
      "type": "object",
      "properties": {
        "from": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "to": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "signals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "links": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "markers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
